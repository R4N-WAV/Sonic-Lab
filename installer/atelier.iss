; Atelier - Windows installer (Inno Setup 6)
; Built by CI:  iscc installer\atelier.iss /DAppVersion=x.y.z /DBuildInfo="..." /DVst3Dir=path\to\Atelier.vst3
; Two calm pages: "Welcome." (with the install folder) and "Installation complete."
; Wizard art is generated by installer/make_images.py (CI) in the Maison style.

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#ifndef BuildInfo
  #define BuildInfo "local build"
#endif
#ifndef Vst3Dir
  #define Vst3Dir "..\build\plugin\Atelier_artefacts\Release\VST3\Atelier.vst3"
#endif
#define HasArt FileExists(AddBackslash(SourcePath) + "art\wizard_164.bmp")
#define HasFont FileExists(AddBackslash(SourcePath) + "..\plugin\Fonts\CormorantGaramond-MediumItalic.ttf")

[Setup]
AppId={{6E2C1B8A-4F7D-4C1E-9A3B-52A7F0D1A4E1}
AppName=Atelier
AppVersion={#AppVersion}
AppVerName=Atelier {#AppVersion}
AppPublisher=R4N
AppComments=Sound design and DSP blueprint workbench ({#BuildInfo})
VersionInfoVersion={#AppVersion}
VersionInfoProductName=Atelier
VersionInfoDescription=Atelier VST3 installer
; The "application directory" is the VST3 folder the bundle goes into.
DefaultDirName={commoncf64}\VST3
DirExistsWarning=no
DisableWelcomePage=no
DisableDirPage=yes
DisableReadyPage=yes
DisableProgramGroupPage=yes
DisableFinishedPage=no
AppendDefaultDirName=no
UsePreviousAppDir=yes
; Keep the uninstaller out of the VST3 folder so hosts never scan it.
UninstallFilesDir={commonpf64}\R4N\Atelier
UninstallDisplayName=Atelier {#AppVersion}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=admin
WizardStyle=modern
WizardSizePercent=100
OutputDir=output
OutputBaseFilename=Atelier_Setup_{#AppVersion}
Compression=lzma2
SolidCompression=yes
SetupLogging=yes
#if HasArt
WizardImageFile=art\wizard_164.bmp,art\wizard_205.bmp,art\wizard_246.bmp,art\wizard_328.bmp
WizardSmallImageFile=art\small_55.bmp,art\small_69.bmp,art\small_83.bmp,art\small_110.bmp
WizardImageStretch=no
WizardImageBackColor=$DAE6EC
#endif

[Messages]
SetupWindowTitle=Atelier setup
WelcomeLabel1=Welcome.
WelcomeLabel2=Atelier will be installed as a VST3 plug-in.
WizardInstalling=Installing
InstallingLabel=
FinishedHeadingLabel=Installation complete.
FinishedLabelNoIcons=
FinishedLabel=
ClickFinish=
ButtonFinish=Finish
ButtonInstall=Install

[Files]
Source: "{#Vst3Dir}\*"; DestDir: "{app}\Atelier.vst3"; Flags: ignoreversion recursesubdirs createallsubdirs
#if HasFont
Source: "..\plugin\Fonts\CormorantGaramond-MediumItalic.ttf"; Flags: dontcopy
Source: "..\plugin\Fonts\IBMPlexMono-Regular.ttf"; Flags: dontcopy
#endif

[InstallDelete]
; Remove the previous bundle completely so no stale files survive an upgrade.
Type: filesandordirs; Name: "{app}\Atelier.vst3"

[UninstallDelete]
Type: filesandordirs; Name: "{app}\Atelier.vst3"

[Code]
const
  FR_PRIVATE = $10;
  CardColor = $F4F9FB;   // #FBF9F4 paper tag
  InkColor  = $16191C;   // #1C1916
  DimColor  = $4C575F;   // #5F574C
  RuleColor = $B4C4CD;   // #CDC4B4

function AddFontResourceEx (lpszFilename: String; fl: DWORD; pdv: Cardinal): Integer;
  external 'AddFontResourceExW@gdi32.dll stdcall';

var
  SerifName, MonoName: String;
  InstallToLabel: TNewStaticText;

function BinaryPath(): String;
begin
  Result := ExpandConstant('{app}\Atelier.vst3\Contents\x86_64-win\Atelier.vst3');
end;

procedure LoadFonts();
begin
  SerifName := 'Georgia';
  MonoName := 'Consolas';
#if HasFont
  try
    ExtractTemporaryFile('CormorantGaramond-MediumItalic.ttf');
    ExtractTemporaryFile('IBMPlexMono-Regular.ttf');
    if AddFontResourceEx(ExpandConstant('{tmp}\CormorantGaramond-MediumItalic.ttf'), FR_PRIVATE, 0) > 0 then
      SerifName := 'Cormorant Garamond Medium';
    if AddFontResourceEx(ExpandConstant('{tmp}\IBMPlexMono-Regular.ttf'), FR_PRIVATE, 0) > 0 then
      MonoName := 'IBM Plex Mono';
  except
  end;
#endif
end;

procedure Headline(L: TNewStaticText);
begin
  L.Font.Name := SerifName;
  L.Font.Size := 24;
  L.Font.Style := [fsItalic];
  L.Font.Color := InkColor;
end;

procedure InitializeWizard();
begin
  LoadFonts();
  WizardForm.Color := CardColor;
  WizardForm.WelcomePage.Color := CardColor;
  WizardForm.FinishedPage.Color := CardColor;
  WizardForm.InnerPage.Color := CardColor;
  WizardForm.MainPanel.Color := CardColor;

  // Welcome.  +  one line  +  the install folder
  Headline(WizardForm.WelcomeLabel1);
  WizardForm.WelcomeLabel1.AutoSize := True;
  WizardForm.WelcomeLabel2.Font.Color := DimColor;
  WizardForm.WelcomeLabel2.Top := WizardForm.WelcomeLabel1.Top + ScaleY(54);
  WizardForm.WelcomeLabel2.Height := ScaleY(24);

  InstallToLabel := TNewStaticText.Create(WizardForm);
  InstallToLabel.Parent := WizardForm.WelcomePage;
  InstallToLabel.Caption := 'INSTALL TO';
  InstallToLabel.Font.Name := MonoName;
  InstallToLabel.Font.Size := 7;
  InstallToLabel.Font.Color := DimColor;
  InstallToLabel.Left := WizardForm.WelcomeLabel2.Left;
  InstallToLabel.Top := WizardForm.WelcomeLabel2.Top + ScaleY(56);

  WizardForm.DirEdit.Parent := WizardForm.WelcomePage;
  WizardForm.DirEdit.Left := WizardForm.WelcomeLabel2.Left;
  WizardForm.DirEdit.Top := InstallToLabel.Top + ScaleY(18);
  WizardForm.DirEdit.Width := WizardForm.WelcomeLabel2.Width - ScaleX(86);
  WizardForm.DirEdit.Font.Name := MonoName;
  WizardForm.DirEdit.Font.Size := 8;
  WizardForm.DirBrowseButton.Parent := WizardForm.WelcomePage;
  WizardForm.DirBrowseButton.Left := WizardForm.DirEdit.Left + WizardForm.DirEdit.Width + ScaleX(6);
  WizardForm.DirBrowseButton.Top := WizardForm.DirEdit.Top - ScaleY(1);
  WizardForm.DirBrowseButton.Width := ScaleX(80);
  WizardForm.DirBrowseButton.Caption := 'Browse';

  // Installation complete.  (nothing underneath)
  Headline(WizardForm.FinishedHeadingLabel);
  WizardForm.FinishedLabel.Visible := False;

  // the installing page header, quiet
  WizardForm.PageNameLabel.Font.Name := SerifName;
  WizardForm.PageNameLabel.Font.Size := 16;
  WizardForm.PageNameLabel.Font.Style := [fsItalic];
  WizardForm.PageDescriptionLabel.Visible := False;
  WizardForm.Bevel1.Visible := False;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = wpFinished then
    WizardForm.FinishedLabel.Visible := False;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
  if (CurPageID = wpWelcome) and (CompareText(WizardDirValue(), ExpandConstant('{commoncf64}\VST3')) <> 0) then
    Result := MsgBox('Your DAW must scan this folder for Atelier to appear:' + #13#10 + WizardDirValue() + #13#10#13#10 + 'Continue?',
                     mbConfirmation, MB_YESNO) = IDYES;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if (CurStep = ssPostInstall) and not FileExists(BinaryPath()) then
    MsgBox('Atelier could not be installed to ' + WizardDirValue() + '.' + #13#10 + 'Run the installer as administrator, or choose another folder.', mbError, MB_OK);
end;
